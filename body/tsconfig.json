{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2024", "DOM", "DOM.Iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": []
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts", "src/vitest-setup.ts"]
}
