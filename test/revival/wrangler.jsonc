{
	"name": "tardigrade-revival",
	"main": "worker.ts",
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": true }, { "type": "Data", "globs": ["**/*.png", "**/*.ico", "**/*.jpg", "**/*.webp"], "fallthrough": true }],
	"durable_objects": { "bindings": [{ "name": "AGENT", "class_name": "RevivalAgent" }, { "name": "REJECTING", "class_name": "RejectingAgent" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RevivalAgent", "RejectingAgent"] }]
}
